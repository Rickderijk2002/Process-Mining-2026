.env
.venv/
__pycache__/
*.pyc
.DS_Store

data/raw/*
!data/raw/.gitkeep

# Quarto intermediates (keep .qmd and final .pdf)
docs/Report/*.tex
docs/Report/*_files/

# Un-ignore before-body.tex and toc.tex, as they are needed for the report to compile correctly
!docs/Report/before-body.tex
!docs/Report/toc.tex

# Output of scripts/reproduce_all.py (compared against the stored results, not stored itself)
data/output/reproduced/
